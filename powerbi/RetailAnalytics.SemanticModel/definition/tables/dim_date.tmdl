/// Calendar dimension. Marked as the model's date table on full_date, which is
/// what enables SAMEPERIODLASTYEAR / DATESINPERIOD / TOTALYTD in the measures.
table dim_date
	lineageTag: 3b1e0001-0000-4000-8000-000000000001
	dataCategory: Time

	column date_key
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-0001-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	/// The model's date column. isKey plus the table's dataCategory: Time is what
	/// marks this as the date table, which is what makes SAMEPERIODLASTYEAR and
	/// DATESINPERIOD work at all. Do not remove either.
	column full_date
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 3b1e0001-0002-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: full_date
		isKey

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-0003-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-0004-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column quarter_name
		dataType: string
		lineageTag: 3b1e0001-0005-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: quarter_name

		annotation SummarizationSetBy = Automatic

	column year_quarter
		dataType: string
		lineageTag: 3b1e0001-0006-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: year_quarter

		annotation SummarizationSetBy = Automatic

	column month
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-0007-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	/// Sorted by [month] so charts run January..December instead of alphabetically.
	column month_name
		dataType: string
		lineageTag: 3b1e0001-0008-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

	column month_short
		dataType: string
		lineageTag: 3b1e0001-0009-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: month_short
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

	column year_month
		dataType: string
		lineageTag: 3b1e0001-000a-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = Automatic

	column month_start
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 3b1e0001-000b-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: month_start

		annotation SummarizationSetBy = Automatic

	column month_end
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 3b1e0001-000c-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: month_end

		annotation SummarizationSetBy = Automatic

	column day_of_month
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-000d-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: day_of_month

		annotation SummarizationSetBy = Automatic

	column day_of_week
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-000e-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column day_name
		dataType: string
		lineageTag: 3b1e0001-000f-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column day_short
		dataType: string
		lineageTag: 3b1e0001-0010-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: day_short
		sortByColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column week_of_year
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-0011-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: week_of_year

		annotation SummarizationSetBy = Automatic

	column day_of_year
		dataType: int64
		formatString: 0
		lineageTag: 3b1e0001-0012-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: day_of_year

		annotation SummarizationSetBy = Automatic

	column is_weekend
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 3b1e0001-0013-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = Automatic

	/// FALSE for December 2011, the month the extract stops mid-way through.
	/// Applied as a page-level filter so YoY is not distorted -- see dax/measures.md.
	column is_complete_month
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 3b1e0001-0014-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: is_complete_month

		annotation SummarizationSetBy = Automatic

	hierarchy 'Date Drill'
		lineageTag: 3b1e0001-00f0-4000-8000-000000000001

		level Year
			lineageTag: 3b1e0001-00f1-4000-8000-000000000001
			column: year

		level Quarter
			lineageTag: 3b1e0001-00f2-4000-8000-000000000001
			column: quarter_name

		level Month
			lineageTag: 3b1e0001-00f3-4000-8000-000000000001
			column: month_short

		level Date
			lineageTag: 3b1e0001-00f4-4000-8000-000000000001
			column: full_date

	partition dim_date = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema="analytics",Item="vw_dim_date"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

